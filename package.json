{
  "name": "thor-input",
  "version": "0.2.0",
  "description": "Ratatoskr: AYN Thor bottom AMOLED screen input driver and Decky plugin (trackpad and keyboard)",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "deploy": "./scripts/deploy.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/venatrix-ritz/Ratatoskr.git"
  },
  "keywords": [
    "decky-plugin",
    "ayn-thor",
    "trackpad",
    "keyboard",
    "input"
  ],
  "author": "Ven",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/venatrix-ritz/Ratatoskr/issues"
  },
  "homepage": "https://github.com/venatrix-ritz/Ratatoskr#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
